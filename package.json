{
  "name": "lan-regie",
  "version": "0.1.0",
  "private": true,
  "description": "Regie-App für die Advanced LAN-Party: CS2-Spielereignisse per OSC an grandMA3 und Playout",
  "author": "Momo",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "overwolf": {
    "packages": []
  },
  "scripts": {
    "build": "node scripts/build.js --minify",
    "build:dev": "node scripts/build.js",
    "start": "npm run build:dev && ow-electron .",
    "test": "node --test test/*.test.js",
    "pack": "npm run build && ow-electron-builder --dir",
    "dist": "npm run build && ow-electron-builder",
    "dist:win": "npm run build && ow-electron-builder --win"
  },
  "build": {
    "appId": "dev.lanregie",
    "productName": "LAN-Regie",
    "icon": "assets/app-icon/icon.png",
    "files": [
      "src/main/**",
      "src/core/**",
      "src/preload/**",
      "dist-app/index.html",
      "assets/app-icon/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "^42.11.4",
    "@overwolf/ow-electron-builder": "^26.9.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
